# frontend-vue/.env.example — Bun+Hono Server (Frontend + GitHub OAuth)
# Salin file ini: cp .env.example .env
# lalu isi nilai yang sesuai.
#
# ── Generate semua secret sekaligus ──────────────────────────────────────────
#   JWT_SECRET            → openssl rand -hex 32   (SAMA dengan root .env)
#   GITHUB_SESSION_SECRET → openssl rand -hex 32   (berbeda dari JWT_SECRET)
#
# ── Cek IP server ─────────────────────────────────────────────────────────────
#   hostname -I | awk '{print $1}'
#
# ── Cek GitHub username kamu ──────────────────────────────────────────────────
#   gh api user --jq .login          (butuh GitHub CLI: https://cli.github.com)
#   git config --global user.name    (alternatif jika gh tidak tersedia)

# Mode: production = serve static files, development = proxy ke Vite dev server
NODE_ENV=production

# ── Port Bun server ───────────────────────────────────────────────────────────
# Cek apakah port sudah dipakai proses lain:
#   ss -tlnp | grep 3000
FRONTEND_PORT=3000

# ── URL ke Rust backend ───────────────────────────────────────────────────────
# Pastikan Rust backend sudah berjalan di URL ini sebelum Bun server distart.
# Cek Rust backend sudah berjalan:
#   curl -s http://YOUR_IP:8080/health || echo "backend tidak merespons"
RUST_BACKEND_URL=http://YOUR_IP:8080

# ── URL frontend ini sendiri ──────────────────────────────────────────────────
# Digunakan sebagai base URL untuk redirect setelah GitHub OAuth selesai.
# Jika pakai domain: FRONTEND_URL=https://domain-kamu.com
# Cek IP server: hostname -I | awk '{print $1}'
FRONTEND_URL=http://YOUR_IP:3000

# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Langkah membuat OAuth App:
#   1. Buka: https://github.com/settings/developers
#   2. Klik "New OAuth App"
#   3. Isi:
#      - Application name  : bebas (contoh: InfoIn Server)
#      - Homepage URL       : nilai FRONTEND_URL di atas
#      - Authorization callback URL: nilai GITHUB_REDIRECT_URI di bawah
#   4. Klik "Register application"
#   5. Salin Client ID ke GITHUB_CLIENT_ID
#   6. Klik "Generate a new client secret" → salin ke GITHUB_CLIENT_SECRET
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Harus sama persis dengan "Authorization callback URL" di GitHub OAuth App settings.
# Format: {FRONTEND_URL}/api/auth/github/callback
# Jika ganti domain, update juga di GitHub OAuth App settings!
GITHUB_REDIRECT_URI=http://YOUR_IP:3000/api/auth/github/callback

# Secret untuk sign session token GitHub. Bebas, gunakan random string yang kuat.
# Generate: openssl rand -hex 32
GITHUB_SESSION_SECRET=your-github-session-secret-here

# ── JWT Secret ────────────────────────────────────────────────────────────────
# WAJIB sama persis dengan JWT_SECRET di root .env (Rust backend).
# Bun sign token dengan secret ini, Rust verify dengan secret yang sama.
# Generate (SEKALI, lalu pakai nilai yang sama di root .env juga):
#   openssl rand -hex 32
JWT_SECRET=your-strong-random-secret-here

# ── Frontend Database ─────────────────────────────────────────────────────────
# Path file SQLite untuk menyimpan frontend config per GitHub user.
# Config ini tersinkron antar browser — servers, labels, urutan card.
# Cek file DB dan ukurannya:
#   ls -lh frontend.db
FRONTEND_DB_PATH=./frontend.db

# ── Admin Default ─────────────────────────────────────────────────────────────
# GitHub username yang dijadikan sumber global config bersama (shared config).
# Semua user lain akan membaca config dari row milik username ini.
# Cek GitHub username kamu:
#   gh api user --jq .login          (butuh GitHub CLI)
#   git config --global user.name    (alternatif)
DEFAULT_ADMIN=your-github-username

# ── Development only ──────────────────────────────────────────────────────────
# URL Vite dev server. Hanya aktif saat NODE_ENV != production.
# Jalankan Vite terlebih dahulu: bun run dev:vite (port 5173)
# Cek Vite sudah berjalan: ss -tlnp | grep 5173
# VITE_DEV_URL=http://localhost:5173
