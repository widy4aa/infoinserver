# Dockerfile for Frontend Dashboard (Vue.js + Nginx)

# Build Stage
FROM docker.io/library/node:26-alpine AS build-stage
WORKDIR /app/frontend-vue
COPY frontend-vue/package*.json ./
RUN npm install
COPY frontend-vue/ ./
# Build (vite.config.js targets outDir: '../static', meaning it will be at /app/static)
RUN npm run build-only

# Production Stage
FROM docker.io/library/nginx:stable-alpine
COPY --from=build-stage /app/static /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]