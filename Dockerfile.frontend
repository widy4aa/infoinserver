# Dockerfile for Frontend Dashboard (Vue.js + Bun + Hono)

# Build Stage — build Vue SPA dengan Node (Vite butuh Node)
FROM docker.io/library/node:22-alpine AS build-stage
WORKDIR /app/frontend-vue
COPY frontend-vue/package*.json ./
RUN npm install
COPY frontend-vue/ ./
# Build Vite → output ke /app/static (sesuai vite.config.js outDir: '../static')
RUN npm run build-only

# Production Stage — jalankan Bun+Hono server
FROM docker.io/oven/bun:1-alpine
WORKDIR /app

# Copy hasil build Vue
COPY --from=build-stage /app/static ./static

# Copy server dan install dependencies Hono
COPY frontend-vue/server.ts ./
COPY frontend-vue/package.json ./
RUN bun install --production

EXPOSE 3000
ENV NODE_ENV=production

CMD ["bun", "run", "server.ts"]
