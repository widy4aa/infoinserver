# Dockerfile for Frontend Dashboard (Vue.js + Nginx)

# Build Stage
FROM node:20-alpine AS build-stage
WORKDIR /app
COPY frontend-vue/package*.json ./
RUN npm install
COPY frontend-vue/ ./
# We build the Vue app into the standard 'dist' folder for Nginx
RUN npm run build-only

# Production Stage
FROM nginx:stable-alpine
COPY --from=build-stage /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]